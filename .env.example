# Copy to .env.local (local) / Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Sanity (sanity.io/manage → project c5x17bia) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_LEADS_DATASET=leads
# Viewer token: draft mode / Presentation preview (server only)
SANITY_API_READ_TOKEN=
# Editor token: writes form leads to the private "leads" dataset (server only)
SANITY_API_WRITE_TOKEN=
# Shared secret of the Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://visad.al

# --- Forms (Phase 8) ---
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Empty = Cloudflare test keys (dev only;
# the production deployment refuses submissions without a secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel Blob (Vercel → Storage → Blob → connect to the project). Empty = local fallback (dev only)
BLOB_READ_WRITE_TOKEN=
# Resend (resend.com, domain visad.al verified). Empty = leads saved, emails skipped
RESEND_API_KEY=
# Sender, on the verified domain
LEADS_FROM_EMAIL=VISAD Construction <noreply@visad.al>

# --- Client review deployment ---
# true = hidden from Google, forms work without Turnstile/Blob keys. Remove for the real launch.
PREVIEW_SITE=

# --- Optional ---
# Show /dev/* routes in a local production build
ENABLE_DEV_ROUTES=
